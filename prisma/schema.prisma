generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String              @id @default(cuid())
  username          String              @unique
  passwordHash      String
  role              String              @default("USER")
  accentTheme       String              @default("volt")
  colorMode         String              @default("dark")
  createdAt         DateTime            @default(now())
  catalogSeeded     Boolean             @default(false)
  workouts          Workout[]
  sports            SportSession[]
  supplements       SupplementIntake[]
  customExercises   CustomExercise[]
  customSupplements CustomSupplement[]
}

model Workout {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  notes     String?
  createdAt DateTime      @default(now())
  exercises ExerciseLog[]

  @@unique([userId, date])
  @@index([userId])
}

model ExerciseLog {
  id        String   @id @default(cuid())
  workoutId String
  workout   Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  sets      SetLog[]
}

model SetLog {
  id            String      @id @default(cuid())
  exerciseLogId String
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  setNumber     Int
  weight        Float
  reps          Int
}

model SupplementIntake {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dose      String
  date      String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model SportSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String
  type             String
  durationMinutes  Int?
  distanceKm       Float?
  distanceMeters   Float?
  pace             String?
  effort           String?
  notes            String?
  createdAt        DateTime @default(now())

  @@index([userId, date])
}

model CustomExercise {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  muscleGroup   String
  defaultWeight Float?
  defaultReps   Int?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model CustomSupplement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  defaultDose String
  iconOrType  String   @default("pill")
  createdAt   DateTime @default(now())

  @@index([userId])
}
