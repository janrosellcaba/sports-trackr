generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String              @id @default(cuid())
  username          String              @unique
  passwordHash      String
  role              String              @default("USER")
  accentTheme       String              @default("volt")
  colorMode         String              @default("dark")
  createdAt         DateTime            @default(now())
  catalogSeeded     Boolean             @default(false)
  gymSessions       GymSession[]
  sports            SportSession[]
  supplements       SupplementIntake[]
  muscles           Muscle[]
  customExercises   CustomExercise[]
  customSupplements CustomSupplement[]
}

model Muscle {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  hits      MuscleHit[]
  exercises CustomExercise[]

  @@unique([userId, name])
  @@index([userId])
}

model GymSession {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  notes     String?
  createdAt DateTime    @default(now())
  hits      MuscleHit[]

  @@unique([userId, date])
  @@index([userId])
}

model MuscleHit {
  id         String     @id @default(cuid())
  sessionId  String
  session    GymSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  muscleId   String?
  muscle     Muscle?    @relation(fields: [muscleId], references: [id], onDelete: SetNull)
  muscleName String
  intensity  Int

  @@index([sessionId])
  @@index([muscleId])
}

model SupplementIntake {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  dose      String
  date      String
  createdAt DateTime @default(now())

  @@index([userId, date])
}

model SportSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date             String
  type             String
  durationMinutes  Int?
  distanceKm       Float?
  distanceMeters   Float?
  pace             String?
  effort           String?
  notes            String?
  createdAt        DateTime @default(now())

  @@index([userId, date])
}

model CustomExercise {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  muscleId      String?
  muscle        Muscle?            @relation(fields: [muscleId], references: [id], onDelete: SetNull)
  workingWeight Float?
  workingReps   Int?
  prWeight      Float?
  prReps        Int?
  prDate        String?
  createdAt     DateTime           @default(now())
  snapshots     ExerciseSnapshot[]

  @@index([userId])
}

model ExerciseSnapshot {
  id            String         @id @default(cuid())
  exerciseId    String
  exercise      CustomExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  date          String
  workingWeight Float?
  workingReps   Int?
  prWeight      Float?
  prReps        Int?
  createdAt     DateTime       @default(now())

  @@unique([exerciseId, date])
  @@index([exerciseId])
}

model CustomSupplement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  defaultDose String
  iconOrType  String   @default("pill")
  createdAt   DateTime @default(now())

  @@index([userId])
}
