generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                String              @id @default(cuid())
  username          String              @unique
  passwordHash      String
  role              String              @default("USER")
  accentTheme       String              @default("volt")
  colorMode         String              @default("dark")
  createdAt         DateTime            @default(now())
  sessions          WorkoutSession[]
  activities        CardioActivity[]
  supplements       SupplementIntake[]
  customExercises   CustomExercise[]
  customSupplements CustomSupplement[]
}

model WorkoutSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  startTime DateTime      @default(now())
  endTime   DateTime?
  notes     String?
  mode      String        @default("LIVE")
  createdAt DateTime      @default(now())
  exercises ExerciseLog[]

  @@index([userId])
}

model ExerciseLog {
  id          String         @id @default(cuid())
  sessionId   String
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  machineName String
  sets        SetLog[]
  order       Int            @default(0)
}

model SetLog {
  id            String      @id @default(cuid())
  exerciseLogId String
  exerciseLog   ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)
  setNumber     Int
  weight        Float
  reps          Int
  rpe           Float?
}

model CardioActivity {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  durationMinutes Int
  intensity       String
  notes           String?
  date            DateTime @default(now())

  @@index([userId])
}

model SupplementIntake {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  label       String?
  catalogId   String?
  amountGrams Float?
  scoops      Float?
  notes       String?
  date        DateTime @default(now())

  @@index([userId])
}

model CustomExercise {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  muscleGroup   String
  defaultWeight Float?
  defaultReps   Int?
  createdAt     DateTime @default(now())

  @@index([userId])
}

model CustomSupplement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  defaultDose String
  iconOrType  String   @default("pill")
  createdAt   DateTime @default(now())

  @@index([userId])
}
